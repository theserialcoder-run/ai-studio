# Wonderboy AI Studio — copy to .env.local, fill what you need, restart the server.
# Keys stay on the server. Never prefix them with NEXT_PUBLIC_. See docs/PROVIDERS.md.

# --- Text AI: companion chat + script assistant ------------------------------
# Google AI Studio key (free tier available for Flash text models).
GEMINI_API_KEY=
# Optional text model override (default gemini-3.8-flash).
GEMINI_TEXT_MODEL=

# Optional alternative: any OpenAI-compatible /chat/completions endpoint
# (Hugging Face router https://router.huggingface.co/v1, Groq, OpenRouter,
#  Cloudflare https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1 ...).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# gemini | openai-compatible (default: first configured)
LLM_PROVIDER=

# --- Images: Cloudflare Workers AI (free daily allocation, no card needed) ---
# FLUX.2 [klein]/[dev] with up to 4 reference images; FLUX.1 [schnell] text-only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Images + video: Gemini (PAID — enable billing on the key's project) ----
# Uses GEMINI_API_KEY. Optional model overrides:
GEMINI_IMAGE_MODEL=
GEMINI_VIDEO_MODEL=

# --- Video: fal.ai (PAID, prepaid credits) ----------------------------------
FAL_KEY=
# Optional model overrides (request fields must match the defaults' schemas):
FAL_I2V_MODEL=
FAL_T2V_MODEL=

# --- Images: your own GPU running ComfyUI (e.g. a RunPod pod) ----------------
# Usually set in the app (Settings → ComfyUI GPU), which overrides these.
# Address of ComfyUI, e.g. https://<pod-id>-8188.proxy.runpod.net
COMFYUI_URL=
# Optional Authorization header value if ComfyUI sits behind a login (e.g. "Bearer …").
COMFYUI_AUTH=
# Optional model file overrides (defaults: z_image_turbo_bf16.safetensors,
# qwen_image_edit_2511_fp8mixed.safetensors).
COMFYUI_ZIMAGE_MODEL=
COMFYUI_QWEN_EDIT_MODEL=

# --- Voice (text-to-speech) -------------------------------------------------
# Kokoro runs locally (free, unlimited, English). fp32 (default) is faster on most
# CPUs; q8 uses half the RAM. Model files are cached in data/models.
KOKORO_DTYPE=
# Gemini TTS (free tier, Hindi + 100 languages) uses GEMINI_API_KEY. Optional model:
# gemini-3.8-flash-tts (default) or gemini-3.8-flash-lite-tts
GEMINI_TTS_MODEL=

# --- Story Cuts (video editing) ---------------------------------------------
# Needs ffmpeg: sudo apt install ffmpeg. Only set these if ffmpeg isn't on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# --- Storage ----------------------------------------------------------------
# Where projects and files are stored (default: ./data).
WONDERBOY_DATA_DIR=
